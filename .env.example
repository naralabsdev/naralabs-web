# Public URLs used by the marketing landing page.
NEXT_PUBLIC_DOCS_URL=/docs
NEXT_PUBLIC_GITHUB_URL=https://github.com/naralabsdev/naralabs-web
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only backend URL (proxied via /api/atlas/*; never expose to browser)
ATLAS_API_URL=http://localhost:8080
# Shared secret for Decode Playground BFF → Atlas POST /v1/playground/decode (set same value on Atlas)
# PLAYGROUND_BFF_TOKEN=
APP_BASE_URL=http://localhost:3000

# Browser WebSocket URL for live home dashboard (optional; auto-derived from NEXT_PUBLIC_APP_URL)
# Production example: wss://api.naralabs.io
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8080

NEXT_PUBLIC_STELLAR_NETWORK=testnet
